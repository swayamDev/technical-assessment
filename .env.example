# Copy to .env.local:  cp .env.example .env.local
# All values below are for the LOCAL Supabase stack started with `npx supabase start`.
# If yours differ, take them from `npx supabase status`.

# Supabase API URL — `npx supabase status` → "Project URL" (API port in supabase/config.toml)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Publishable (browser-safe) key — `npx supabase status` → "Publishable"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Secret (service-role) key — `npx supabase status` → "Secret". SERVER ONLY: never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_N7UND0UgjKTVK-Uodkm0Hg_xSvEMPvz

# Postgres connection used by Prisma at runtime — `npx supabase status` → "Database URL" (DB port in supabase/config.toml)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Direct (non-pooled) Postgres connection — same as DATABASE_URL locally, since the pooler is disabled
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# HMAC-SHA256 key shared with the payment gateway for webhook signatures (x_signature).
# Local test value from the assessment brief's test vector.
GATEWAY_X_SIGNATURE_KEY=test_x_signature_key
